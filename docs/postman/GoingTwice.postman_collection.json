                  "const n = Number(pm.collectionVariables.get(\"agentPolls\") || 0) + 1;",
                  "pm.collectionVariables.set(\"agentPolls\", n);",
                  "const agentHigh = lot.highPaddleId === pm.collectionVariables.get(\"agentId\");",
                  "if (!agentHigh && n < 15) { if (pm.execution && pm.execution.setNextRequest) pm.execution.setNextRequest(pm.info.requestName); else postman.setNextRequest(pm.info.requestName); }",
