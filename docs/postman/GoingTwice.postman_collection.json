              ],
              "query": [
                {
                  "key": "room",
                  "value": "{{room}}"
                }
              ]
            },
            "description": "An absentee bidder: one sentence becomes a bidding policy. The AI only proposes; every agent bid goes through the same engine validation as a human tap, capped by maxBid and the hold."
          }
