          "name": "Close the auction (captures, voids, Payouts batch, receipts)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "const caps = s.ledger.filter(r => r.kind === \"captured\" && r.status !== \"FAILED\");",
                  "const voids = s.ledger.filter(r => r.kind === \"voided\" && r.status !== \"FAILED\");",
                  "pm.test(\"auction closed\", () => pm.expect(s.status).to.eql(\"closed\"));",
                  "pm.test(\"every capture is LESS than that paddle's hold (partial final_capture)\", () => { pm.expect(caps.length).to.be.at.least(2); caps.forEach(c => { const p = s.paddles.find(x => x.id === c.paddleId); pm.expect(c.amount).to.be.below(p.holdAmount); }); });",
                  "pm.test(\"one capture per winner\", () => pm.expect(new Set(caps.map(c => c.paddleId)).size).to.eql(caps.length));",
                  "pm.test(\"non-winners voided (Casey never won)\", () => { pm.expect(voids.length).to.be.at.least(1); pm.expect(s.paddles.find(p => p.id === pm.collectionVariables.get(\"paddle3\")).status).to.eql(\"voided\"); });",
                  "pm.test(\"nothing left on hold\", () => pm.expect(s.totals.held).to.eql(0));",
                  "pm.test(\"payout == captured\", () => pm.expect(s.totals.paidOut).to.eql(s.totals.captured));",
                  "pm.collectionVariables.set(\"ledgerLen\", s.ledger.length);"
                ]
