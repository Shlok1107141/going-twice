        {
          "name": "State: 4 holds placed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test(\"4 held paddles\", () => pm.expect(s.paddles.filter(p => p.status === \"held\").length).to.eql(4));",
                  "pm.test(\"held total = sum of holds\", () => pm.expect(s.totals.held).to.eql(800));",
                  "pm.test(\"one authorized ledger row per paddle\", () => pm.expect(s.ledger.filter(r => r.kind === \"authorized\").length).to.eql(4));"
                ]
              }
            }
