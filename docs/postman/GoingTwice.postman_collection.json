              "mode": "raw",
              "raw": "{\n  \"name\": \"Dana (absentee)\",\n  \"holdAmount\": 150,\n  \"instruction\": \"Bid on the signed class quilt, up to $120.\",\n  \"maxBid\": 120,\n  \"lotId\": \"lot-quilt\",\n  \"testCard\": true\n}",
              "options": {
